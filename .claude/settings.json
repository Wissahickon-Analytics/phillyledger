{
  "model": "opus",
  "effortLevel": "xhigh",
  "env": {
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-2"
  },
  "permissions": {
    "additionalDirectories": ["../gov-budget-data"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_reference_repo.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_python.py"
          }
        ]
      }
    ]
  }
}
